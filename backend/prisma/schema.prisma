generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String       @id @default(uuid())
  name          String
  nif           String       @unique
  email         String       @unique
  phone         String?
  address       String?
  sector        String?
  status        TenantStatus @default(TRIAL)
  planType      PlanType     @default(FREE)
  trialEndsAt   DateTime?
  settings      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  regime        FiscalRegime @default(GERAL)
  companyType   String?
  employeeCount Int?
  retentionRate Float        @default(0)

  aiQuestions      AIQuestion[]
  auditLogs        AuditLog[]
  clients          Client[]
  companySettings  CompanySettings?
  emailLogs        EmailLog[]
  fiscalAlerts     FiscalAlert[]
  employees        Employee[]
  obligations      FiscalObligation[]
  invoices         Invoice[]
  notifications    Notification[]
  payrolls         Payroll[]
  products         Product[]
  purchaseInvoices PurchaseInvoice[]
  revenues         Revenue[]
  smsLogs          SMSLog[]
  subscriptions    Subscription[]
  suppliers        Supplier[]
  taxAssessments   TaxAssessment[]
  taxCalculations  TaxCalculation[]
  declarations     TaxDeclaration[]
  payments         TaxPayment[]
  taxTransactions  TaxTransaction[]
  users            User[]
  documents        Document[]

  @@index([nif])
  @@index([regime])
}

model User {
  id               String    @id @default(uuid())
  tenantId         String
  email            String
  password         String
  name             String
  role             UserRole  @default(VIEWER)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLogin        DateTime?
  avatar           String?
  phone            String?
  twoFactorEnabled Boolean   @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([email, tenantId])
  @@index([tenantId])
}

model Client {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  nif       String?
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  notes     String?
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([tenantId])
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  price       Float
  ivaRate     Float    @default(14)
  createdAt   DateTime @default(now())
  code        String?
  isActive    Boolean  @default(true)
  stock       Float?
  updatedAt   DateTime @updatedAt

  invoiceItems         InvoiceItem[]
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseInvoiceItems PurchaseInvoiceItem[]

  @@index([tenantId])
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  clientId       String
  invoiceNumber  String
  subtotal       Float
  iva            Float
  withholdingTax Float         @default(0)
  total          Float
  status         InvoiceStatus @default(PENDING)
  notes          String?
  createdAt      DateTime      @default(now())
  dueDate        DateTime?
  issuedAt       DateTime      @default(now())
  pdfUrl         String?
  qrCode         String?

  client    Client        @relation(fields: [clientId], references: [id])
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items     InvoiceItem[]
  documents Document[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([clientId])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  productName String
  quantity    Float
  unitPrice   Float
  total       Float
  productId   String?

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model Revenue {
  id        String   @id @default(uuid())
  tenantId  String
  month     Int
  year      Int
  amount    Float
  notes     String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([year, month])
}

model FiscalCalendar {
  id                String         @id @default(uuid())
  title             String
  taxType           TaxType
  dueDate           DateTime
  description       String?
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  code              String?        @unique
  obligationType    ObligationType
  officialReference String?
  period            String?
  referenceYear     Int
  source            String?
  sourceUrl         String?
  updatedAt         DateTime       @updatedAt

  regimes     FiscalCalendarRegime[]
  obligations FiscalObligation[]

  @@index([taxType])
  @@index([obligationType])
  @@index([referenceYear])
  @@index([dueDate])
  @@index([active])
}

model FiscalCalendarRegime {
  id         String       @id @default(uuid())
  calendarId String
  regime     FiscalRegime

  calendar FiscalCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, regime])
  @@index([regime])
}

model FiscalObligation {
  id               String           @id @default(uuid())
  tenantId         String
  type             ObligationType
  description      String?
  dueDate          DateTime
  amount           Float?
  createdAt        DateTime         @default(now())
  status           ObligationStatus @default(PENDING)
  title            String
  updatedAt        DateTime         @updatedAt
  alertDaysBefore  Int              @default(7)
  alertEnabled     Boolean          @default(true)
  fiscalCalendarId String?
  lastReminderAt   DateTime?
  period           String?
  reminderSent     Boolean          @default(false)

  fiscalCalendar FiscalCalendar? @relation(fields: [fiscalCalendarId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalAlerts   FiscalAlert[]

  @@index([tenantId])
  @@index([fiscalCalendarId])
  @@index([dueDate])
  @@index([status])
  @@index([tenantId, dueDate])
  @@index([tenantId, status])
}

model FiscalAlert {
  id               String   @id @default(uuid())
  tenantId         String
  obligationId     String
  daysBefore       Int
  notificationSent Boolean  @default(false)
  emailSent        Boolean  @default(false)
  smsSent          Boolean  @default(false)
  smsStatus        String?
  whatsappSent     Boolean  @default(false)
  whatsappStatus   String?
  emailStatus      String?
  notificationId   String?
  sentAt           DateTime @default(now())
  createdAt        DateTime @default(now())

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  obligation FiscalObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@unique([obligationId, daysBefore])
  @@index([tenantId])
  @@index([obligationId])
  @@index([sentAt])
}

model TaxDeclaration {
  id              String            @id @default(uuid())
  tenantId        String
  taxType         TaxType
  period          String
  declaredAmount  Float
  paidAmount      Float             @default(0)
  status          DeclarationStatus @default(PENDING)
  declarationDate DateTime          @default(now())
  paymentDate     DateTime?
  notes           String?

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments TaxPayment[]

  @@index([tenantId])
  @@index([taxType])
  @@index([period])
}

model TaxPayment {
  id            String   @id @default(uuid())
  tenantId      String
  declarationId String?
  taxType       TaxType
  amount        Float
  reference     String?
  paymentMethod String?
  paidAt        DateTime @default(now())

  declaration TaxDeclaration? @relation(fields: [declarationId], references: [id])
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([declarationId])
  @@index([taxType])
}

model Notification {
  id               String           @id @default(uuid())
  tenantId         String
  message          String
  createdAt        DateTime         @default(now())
  isRead           Boolean          @default(false)
  title            String
  notificationType NotificationType @default(INFO)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isRead])
}

model Subscription {
  id            String        @id @default(uuid())
  tenantId      String
  planType      PlanType
  priceKwanza   Float
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean       @default(true)
  paymentRef    String?
  createdAt     DateTime      @default(now())
  currency      String        @default("AOA")
  paymentStatus PaymentStatus @default(PENDING)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TaxCalculation {
  id        String   @id @default(uuid())
  tenantId  String
  taxType   String
  createdAt DateTime @default(now())
  amount    Float
  notes     String?
  rate      String
  tax       Float
  total     Float

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([taxType])
}

model AIQuestion {
  id        String   @id @default(uuid())
  tenantId  String
  question  String
  answer    String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([entity])
  @@index([entityId])
}

model SMSLog {
  id       String   @id @default(uuid())
  tenantId String
  phone    String
  message            String
  status             String
  provider           String?
  channel            String   @default("SMS")
  providerMessageId  String?
  errorMessage       String?
  sentAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model EmailLog {
  id       String   @id @default(uuid())
  tenantId String
  email    String
  subject  String
  body     String?
  status   String
  sentAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Legislation {
  id              String              @id @default(uuid())
  title           String
  taxType         TaxType
  category        LegislationCategory @default(OUTROS)
  description     String?
  content         String?
  lawNumber       String?
  article         String?
  subject         String?
  source          String?
  sourceUrl       String?
  publicationDate DateTime?
  effectiveDate   DateTime?
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([taxType])
  @@index([category])
  @@index([subject])
  @@index([active])
  @@index([publicationDate])
}

model CompanySettings {
  id                    String  @id @default(uuid())
  tenantId              String  @unique
  companyLogo           String?
  invoicePrefix         String?
  smsEnabled            Boolean @default(true)
  emailEnabled          Boolean @default(true)
  whatsappEnabled       Boolean @default(false)
  whatsappOptInAt       DateTime?
  aiEnabled             Boolean @default(true)
  fiscalAlertDaysBefore Int     @default(7)
  fiscalAlertsEnabled   Boolean @default(true)
  fiscalDueDateReminder Boolean @default(true)
  fiscalReminderEnabled Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  nif       String?
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([nif])
}

model PurchaseInvoice {
  id             String        @id @default(uuid())
  tenantId       String
  supplierId     String
  invoiceNumber  String
  subtotal       Float
  iva            Float         @default(0)
  withholdingTax Float         @default(0)
  total          Float
  status         InvoiceStatus @default(PENDING)
  notes          String?
  pdfUrl         String?
  issuedAt       DateTime      @default(now())
  dueDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([supplierId])
  @@index([issuedAt])
  @@index([status])
}

model PurchaseInvoiceItem {
  id                String  @id @default(uuid())
  purchaseInvoiceId String
  productId         String?
  productName       String
  quantity          Float
  unitPrice         Float
  total             Float

  product Product? @relation(fields: [productId], references: [id])

  @@index([purchaseInvoiceId])
  @@index([productId])
}

model TaxTransaction {
  id               String           @id @default(uuid())
  tenantId         String
  taxType          TaxType
  operation        TaxRuleOperation
  period           String
  referenceDate    DateTime
  sourceType       String
  sourceId         String?
  baseAmount       Float            @default(0)
  taxAmount        Float            @default(0)
  deductibleAmount Float            @default(0)
  withheldAmount   Float            @default(0)
  description      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([taxType])
  @@index([operation])
  @@index([period])
  @@index([referenceDate])
  @@index([sourceType, sourceId])
}

model TaxAssessment {
  id                String   @id @default(uuid())
  tenantId          String
  taxType           TaxType
  period            String
  year              Int
  taxableAmount     Float    @default(0)
  taxDueAmount      Float    @default(0)
  deductibleAmount  Float    @default(0)
  withheldAmount    Float    @default(0)
  adjustmentsAmount Float    @default(0)
  finalAmount       Float    @default(0)
  status            String   @default("DRAFT")
  calculatedAt      DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, taxType, period, year])
  @@index([tenantId])
  @@index([taxType])
  @@index([period, year])
  @@index([status])
}

model TaxRule {
  id              String            @id @default(uuid())
  name            String
  description     String?
  taxType         TaxType
  regime          FiscalRegime?
  operation       TaxRuleOperation?
  sector          String?
  companyType     String?
  rate            Decimal?          @db.Decimal(10, 6)
  fixedAmount     Decimal?          @db.Decimal(18, 2)
  minAmount       Decimal?          @db.Decimal(18, 2)
  maxAmount       Decimal?          @db.Decimal(18, 2)
  calculationBase String?
  conditions      Json?
  deductions      Json?
  legalReference  String?
  legalArticle    String?
  officialSource  String?
  validFrom       DateTime
  validTo         DateTime?
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([taxType])
  @@index([regime])
  @@index([operation])
  @@index([active])
  @@index([validFrom, validTo])
}

model Employee {
  id                   String         @id @default(uuid())
  tenantId             String
  employeeNumber       String?
  name                 String
  nif                  String?
  socialSecurityNumber String?
  email                String?
  phone                String?
  address              String?
  birthDate            DateTime?
  hireDate             DateTime?
  terminationDate      DateTime?
  jobTitle             String?
  department           String?
  maritalStatus        String?
  gender               String?
  dependentCount       Int            @default(0)
  status               EmployeeStatus @default(ACTIVE)
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dependents   EmployeeDependent[]
  salaries     EmployeeSalary[]
  payrollItems PayrollItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, nif])
  @@index([tenantId, socialSecurityNumber])
}

model EmployeeDependent {
  id           String    @id @default(uuid())
  employeeId   String
  name         String
  relationship String?
  birthDate    DateTime?
  taxDependent Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeSalary {
  id                 String    @id @default(uuid())
  employeeId         String
  baseSalary         Decimal   @db.Decimal(18, 2)
  foodAllowance      Decimal   @default(0) @db.Decimal(18, 2)
  transportAllowance Decimal   @default(0) @db.Decimal(18, 2)
  otherAllowances    Decimal   @default(0) @db.Decimal(18, 2)
  bonuses            Decimal   @default(0) @db.Decimal(18, 2)
  commissions        Decimal   @default(0) @db.Decimal(18, 2)
  otherIncome        Decimal   @default(0) @db.Decimal(18, 2)
  effectiveFrom      DateTime
  effectiveTo        DateTime?
  active             Boolean   @default(true)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([employeeId, active])
  @@index([effectiveFrom])
}

model Payroll {
  id                    String        @id @default(uuid())
  tenantId              String
  period                String
  month                 Int
  year                  Int
  status                PayrollStatus @default(DRAFT)
  employeeCount         Int           @default(0)
  grossAmount           Decimal       @default(0) @db.Decimal(18, 2)
  socialSecurityAmount  Decimal       @default(0) @db.Decimal(18, 2)
  irtAmount             Decimal       @default(0) @db.Decimal(18, 2)
  otherDeductionsAmount Decimal       @default(0) @db.Decimal(18, 2)
  netAmount             Decimal       @default(0) @db.Decimal(18, 2)
  processedAt           DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  PayrollItem[]

  @@unique([tenantId, period])
  @@index([tenantId])
  @@index([tenantId, year, month])
  @@index([status])
}

model PayrollItem {
  id                   String   @id @default(uuid())
  payrollId            String
  employeeId           String
  employeeName         String
  employeeNif          String?
  socialSecurityNumber String?
  dependentCount       Int      @default(0)
  baseSalary           Decimal  @default(0) @db.Decimal(18, 2)
  foodAllowance        Decimal  @default(0) @db.Decimal(18, 2)
  transportAllowance   Decimal  @default(0) @db.Decimal(18, 2)
  otherAllowances      Decimal  @default(0) @db.Decimal(18, 2)
  bonuses              Decimal  @default(0) @db.Decimal(18, 2)
  commissions          Decimal  @default(0) @db.Decimal(18, 2)
  otherIncome          Decimal  @default(0) @db.Decimal(18, 2)
  grossAmount          Decimal  @default(0) @db.Decimal(18, 2)
  socialSecurityBase   Decimal  @default(0) @db.Decimal(18, 2)
  socialSecurityAmount Decimal  @default(0) @db.Decimal(18, 2)
  irtTaxableAmount     Decimal  @default(0) @db.Decimal(18, 2)
  irtAmount            Decimal  @default(0) @db.Decimal(18, 2)
  otherDeductions      Decimal  @default(0) @db.Decimal(18, 2)
  netAmount            Decimal  @default(0) @db.Decimal(18, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  payroll  Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  @@unique([payrollId, employeeId])
  @@index([payrollId])
  @@index([employeeId])
}

model Document {
  id           String           @id @default(uuid())
  tenantId     String
  name         String
  originalName String
  description  String?
  category     DocumentCategory @default(OUTROS)
  mimeType     String
  size         Int
  filePath     String
  fileUrl      String?
  invoiceId    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([category])
  @@index([invoiceId])
  @@index([createdAt])
}

enum UserRole {
  OWNER
  ADMIN
  ACCOUNTANT
  VIEWER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum PlanType {
  FREE
  BASIC
  PREMIUM
  ENTERPRISE
}

enum TaxType {
  IVA
  IRT
  INDUSTRIAL
  SELO
  SS
  IEC
  II
  IAC
  IP
  IVM
  IEJ
  IS
  CEOC
  IRP
  RCN
  TS
  CFQA
  ITP
  IPP
  IVRM
  TAXA_GAS
}

enum DeclarationStatus {
  PENDING
  PAID
  PARTIAL
  LATE
}

enum ObligationType {
  IVA
  IRT
  II
  SS
  DECLARACAO
  IEC
  IAC
  IP
  IVM
  IEJ
  IS
  CEOC
  IRP
  RCN
  TS
  CFQA
  ITP
  IPP
  IVRM
  PAGAMENTO
  RETENCAO
  SAFT
  OUTRA
}

enum ObligationStatus {
  PENDING
  PAID
  LATE
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum FiscalRegime {
  GERAL
  SIMPLIFICADO
  PRESTADOR_SERVICO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum LegislationCategory {
  LEI
  DECRETO
  DECRETO_PRESIDENCIAL
  DECRETO_EXECUTIVO
  DESPACHO
  INSTRUTIVO
  AVISO
  CIRCULAR
  REGULAMENTO
  OUTROS
}

enum TaxRuleOperation {
  PURCHASE
  SALE
  SERVICE
  IMPORT
  EXPORT
  PAYROLL
  OTHER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  CLOSED
}

enum DocumentCategory {
  FACTURA
  RECIBO
  DECLARACAO
  PAGAMENTO
  CONTRATO
  EMPRESA
  COMPROVATIVO
  RELATORIO
  OUTROS
}
