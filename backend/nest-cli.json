{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "saft/schemas/*.xsd",
        "outDir": "dist"
      },
      {
        "include": "saft/validators/*.mjs",
        "outDir": "dist"
      }
    ]
  }
}
