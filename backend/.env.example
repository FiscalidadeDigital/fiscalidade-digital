# Aplicação
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Base de dados local/de testes. Nunca aponte os testes para produção.
DATABASE_URL=postgresql://user:password@localhost:5432/fiscalidade_digital

# Segredos distintos, aleatorios e com pelo menos 32 bytes cada.
# Nunca reutilize o segredo dos utilizadores no contexto de administracao.
JWT_SECRET=replace-with-a-long-random-tenant-secret
ADMIN_JWT_SECRET=replace-with-a-different-long-random-admin-secret

# Politicas e armazenamento local. A duracao do trial e configuravel.
TRIAL_DURATION_DAYS=7
DOCUMENT_STORAGE_DIR=./uploads

# Integracoes opcionais. Configure apenas os fornecedores realmente activos.
OPENAI_API_KEY=
EMAIL_USER=
EMAIL_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=

# Usados apenas pelo comando npm run admin:bootstrap.
ADMIN_BOOTSTRAP_EMAIL=admin@example.invalid
ADMIN_BOOTSTRAP_NAME=Administrador
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-temporary-strong-password

# Facturação Electrónica AGT. Desactivada até existirem credenciais oficiais,
# chave de contribuinte e certificação. Nunca reutilize a chave SAF-T.
AGT_EINVOICE_ENVIRONMENT=homologation
AGT_EINVOICE_USERNAME=
AGT_EINVOICE_PASSWORD=
AGT_EINVOICE_PRODUCT_ID=
AGT_EINVOICE_PRODUCT_VERSION=
AGT_EINVOICE_SOFTWARE_VALIDATION_NUMBER=
AGT_EINVOICE_SIGNATURE_VERSION=1
AGT_EINVOICE_PRIVATE_KEY=
AGT_EINVOICE_TIMEOUT_MS=15000
AGT_EINVOICE_TRANSMISSION_ENABLED=false
